prefix=@CMAKE_INSTALL_PREFIX@
exec_prefix=${prefix}
libdir=${exec_prefix}/lib
includedir=${prefix}/include

Name: carla-client
Description: CARLA Simulator Client Library - Static library for autonomous driving simulation
Version: @CARLA_VERSION@
URL: https://carla.org
Requires:
Libs: -L${libdir} -lcarla-client
Libs.private: -pthread -ldl -lm
Cflags: -I${includedir} -I${includedir}/third-party -std=c++14